# AccessGuard Environment Configuration

PROJECT_NAME=AccessGuard
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use sqlite:///./accessguard.db for zero-dependency local dev or PostgreSQL+PostGIS for production
DATABASE_URL=sqlite:///./accessguard.db
# DATABASE_URL=postgresql+psycopg2://accessguard:accessguard_secret_db_pass@localhost:5432/accessguard_db

# Computer Vision Model Adapter
# Options: "heuristic", "torchvision", "yolo", "dummy"
CV_ADAPTER=heuristic

# Privacy & Security Safeguards
ENABLE_PRIVACY_BLURRING=true
STRIP_EXIF_AFTER_EXTRACTION=true
MINIMIZE_MEDIA_RETENTION=true
MEDIA_RETENTION_HOURS=72

# Upload Size Limits
MAX_IMAGE_SIZE_BYTES=20971520
MAX_VIDEO_SIZE_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=60

# Verification & Consensus Thresholds
MIN_VERIFICATIONS_TO_CONFIRM=3
CONSENSUS_AGREEMENT_RATIO=0.67
